gh = github_repo("duckdb/duckdb")

release = gh.latest_release()

os_str = {
   "linux": "linux",
   "macos": "osx",
   "windows": "windows",
}[os]

arch_str = {
    "x86_64": "amd64",
    "aarch64": "arm64",
}[arch]

asset = release.get_asset_url("duckdb_cli-{os_str}-{arch_str}.zip".format(os_str=os_str, arch_str=arch_str))
install_binary(extract_from_url(asset, "duckdb"), "duckdb")
